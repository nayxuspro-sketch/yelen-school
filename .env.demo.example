# ============================================================================
#  YELEN SCHOOL — Instance de DÉMONSTRATION publique (offre hébergée, B8)
# ============================================================================
#  Copier ce fichier en `.env.demo` sur le serveur d'hébergement, puis :
#     docker compose -f docker-compose.demo.yml up -d --build
#
#  Une instance de démonstration n'est jamais licenciée et ne communique pas
#  avec l'extérieur : DEMO_MODE=true coupe les SMS, l'e-mail, les notifications
#  push et les demandes Mobile Money (voir core/mode_demo.py).
# ----------------------------------------------------------------------------

# --- Base de données PostgreSQL (conteneur db du compose de démonstration) ---
DB_NAME=yelen_demo
DB_USER=yelen_demo
# Mot de passe UNIQUE à cette instance — jamais celui d'une école.
DB_PASSWORD=CHANGEZ-MOI

# --- Sécurité ---------------------------------------------------------------
# Clé de signature propre à l'instance (générer : python -c "import secrets;print(secrets.token_urlsafe(64))")
SECRET_KEY=CHANGEZ-MOI
DEBUG=false
# Adresse publique de la démonstration (domaine + éventuel sous-chemin).
ALLOWED_HOSTS=demo.exemple.bf,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://demo.exemple.bf

# --- Mode démonstration -----------------------------------------------------
DEMO_MODE=true
LICENSE_ENFORCEMENT=false

# --- Port HTTP publié par le conteneur web ----------------------------------
YELEN_HTTP_PORT=8001

# --- Sorties coupées (ceinture et bretelles en plus de DEMO_MODE) -----------
SMS_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.dummy.EmailBackend
