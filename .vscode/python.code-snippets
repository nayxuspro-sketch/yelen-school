  "Django Model Yelen": {
    "prefix": "yelen-model",
    "body": [
      "\"\"\"",
      "${1:Description du modèle}",
      "",
      "Attributs:",
      "    ${2:attribut} (${3:Type}): ${4:Description}",
      "\"\"\"",
      "",
      "class ${5:NomModele}(models.Model):",
      "    \"\"\"${1:Description du modèle}\"\"\"",
      "",
      "    # Champs",
      "    ${2:nom} = models.${6:CharField}(max_length=${7:100}, verbose_name=\"${8:Nom}\")",
      "    actif = models.BooleanField(default=True, verbose_name=\"Actif\")",
      "    ",
      "    # Métadonnées",
      "    date_creation = models.DateTimeField(auto_now_add=True, verbose_name=\"Date de création\")",
      "    date_modification = models.DateTimeField(auto_now=True, verbose_name=\"Date de modification\")",
      "",
      "    class Meta:",
      "        verbose_name = \"${9:Nom singulier}\"",
      "        verbose_name_plural = \"${10:Nom pluriel}\"",
      "        ordering = [\"-date_creation\"]",
      "",
      "    def __str__(self) -> str:",
      "        \"\"\"Représentation textuelle\"\"\"",
      "        return f\"{self.${2:nom}}\"",
      "",
      "    def save(self, *args, **kwargs) -> None:",
      "        \"\"\"Sauvegarde avec logique métier\"\"\"",
      "        ${11:# Logique avant sauvegarde}",
      "        super().save(*args, **kwargs)",
      "$0"
    ],
    "description": "Modèle Django standard Yelen School"
  },

