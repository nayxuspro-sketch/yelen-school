      "    ",
      "    Template: ${3:app/nom}_list.html",
      "    Context: object_list",
      "    \"\"\"",
      "    ",
      "    model = ${4:Modele}",
      "    template_name = \"${3:app/nom}_list.html\"",
      "    context_object_name = \"${5:objets}\"",
      "    paginate_by = 20",
      "    ",
      "    def get_queryset(self):",
      "        \"\"\"Filtre personnalisé\"\"\"",
      "        queryset = super().get_queryset()",
      "        return queryset.filter(actif=True).select_related(${6:}).prefetch_related(${7:})",
      "    ",
      "    def get_context_data(self, **kwargs):",
      "        \"\"\"Contexte supplémentaire\"\"\"",
      "        context = super().get_context_data(**kwargs)",
      "        ${8:# Ajout de données au contexte}",
      "        return context",
      "$0"
    ],
    "description": "ListView Django Yelen School"
  },

