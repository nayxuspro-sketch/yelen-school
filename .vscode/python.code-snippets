  // ─────────────────────────────────────────────────────────────────
  // 📄 GÉNÉRATION PDF (WeasyPrint)
  // ─────────────────────────────────────────────────────────────────
  "Generate PDF WeasyPrint": {
    "prefix": "yelen-pdf",
    "body": [
      "def generer_${1:document}_pdf(${2:objet}) -> HttpResponse:",
      "    \"\"\"",
      "    Génère le PDF ${3:description}",
      "    ",
      "    Args:",
      "        ${2:objet}: Instance du modèle",
      "    ",
      "    Returns:",
      "        HttpResponse avec le PDF",
      "    \"\"\"",
      "    # Contexte du template",
      "    context = {",
      "        '${2:objet}': ${2:objet},",
      "        ${4:# Autres données}",
      "    }",
      "    ",
      "    # Rendu HTML",
      "    html_string = render_to_string('${5:app/template}.html', context)",
      "    ",
      "    # Génération PDF",
      "    html = HTML(string=html_string)",
      "    pdf = html.write_pdf()",
      "    ",
      "    # Réponse HTTP",
      "    response = HttpResponse(pdf, content_type='application/pdf')",
      "    response['Content-Disposition'] = f'inline; filename=\"${6:document}_{${2:objet}.pk}.pdf\"'",
      "    ",
      "    return response",
      "$0"
    ],
    "description": "Génération PDF avec WeasyPrint"
  },

