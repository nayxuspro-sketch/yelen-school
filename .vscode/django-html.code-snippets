{
  // ═══════════════════════════════════════════════════════════════════
  // YELEN SCHOOL - Snippets HTML Django Templates
  // Templates HTMX + Alpine.js + Tailwind CSS
  // ═══════════════════════════════════════════════════════════════════

  // ─────────────────────────────────────────────────────────────────
  // 🎨 STRUCTURE BASE
  // ─────────────────────────────────────────────────────────────────
  "Django Template Base": {
    "prefix": "yelen-base",
    "body": [
      "{% extends 'base.html' %}",
      "{% load static %}",
      "",
      "{% block title %}${1:Titre de la page}{% endblock %}",
      "",
      "{% block content %}",
      "<div class=\"content\">",
      "  <div class=\"topbar-title\">",
      "    <h1 class=\"text-2xl font-semibold text-text-primary\">${1:Titre de la page}</h1>",
      "  </div>",
      "",
      "  ${2:<!-- Contenu principal -->}",
      "</div>",
      "{% endblock %}",
      "$0"
    ],
    "description": "Template Django de base Yelen School"
  },

  // ─────────────────────────────────────────────────────────────────
  // 🎯 COMPOSANTS DESIGN SYSTEM
  // ─────────────────────────────────────────────────────────────────
  "Yelen Card": {
    "prefix": "yelen-card",
    "body": [
      "<div class=\"card\">",
      "  <div class=\"card-header\">",
      "    <h3 class=\"text-lg font-semibold text-text-primary\">${1:Titre de la carte}</h3>",
      "  </div>",
      "  <div class=\"card-body\">",
      "    ${2:<!-- Contenu de la carte -->}",
      "  </div>",
      "</div>",
      "$0"
    ],
    "description": "Carte Yelen School"
  },

  "Yelen Button Primary": {
    "prefix": "yelen-btn-primary",
    "body": [
      "<button",
      "  type=\"${1:button}\"",
      "  class=\"btn-primary\"",
      "  ${2:hx-post=\"{% url '${3:app:action}' %}\"}",
      "  ${4:hx-target=\"#${5:target}\"}",
      ">",
      "  ${6:Texte du bouton}",
      "</button>",
      "$0"
    ],
    "description": "Bouton primaire Yelen"
  },

  "Yelen Badge": {
    "prefix": "yelen-badge",
    "body": [
      "<span class=\"badge badge-${1|success,warning,danger,info|}\">${2:Texte}</span>",
      "$0"
    ],
    "description": "Badge Yelen School"
  },

  "Yelen Input": {
    "prefix": "yelen-input",
    "body": [
      "<div class=\"form-group\">",
      "  <label for=\"id_${1:champ}\" class=\"input-label\">${2:Libellé}</label>",
      "  <input",
      "    type=\"${3:text}\"",
      "    name=\"${1:champ}\"",
      "    id=\"id_${1:champ}\"",
      "    class=\"input\"",
      "    placeholder=\"${4:Placeholder}\"",
      "    ${5:required}",
      "  />",
      "  ${6:<span class=\"input-error\">{{ form.${1:champ}.errors }}</span>}",
      "</div>",
      "$0"
    ],
    "description": "Champ de formulaire Yelen"
  },

  "Yelen Table": {
    "prefix": "yelen-table",
    "body": [
      "<div class=\"card\">",
      "  <table class=\"data-table\">",
      "    <thead>",
      "      <tr>",
      "        <th>${1:Colonne 1}</th>",
      "        <th>${2:Colonne 2}</th>",
      "        <th>${3:Actions}</th>",
      "      </tr>",
      "    </thead>",
      "    <tbody>",
      "      {% for ${4:objet} in ${5:objets} %}",
      "      <tr>",
      "        <td>{{ ${4:objet}.${6:champ1} }}</td>",
      "        <td>{{ ${4:objet}.${7:champ2} }}</td>",
      "        <td>",
      "          <button class=\"btn-secondary\">Modifier</button>",
      "        </td>",
      "      </tr>",
      "      {% empty %}",
      "      <tr>",
      "        <td colspan=\"3\" class=\"text-center text-text-muted py-8\">",
      "          Aucune donnée disponible",
      "        </td>",
      "      </tr>",
      "      {% endfor %}",
      "    </tbody>",
      "  </table>",
      "</div>",
      "$0"
    ],
    "description": "Tableau de données Yelen"
  },

  // ─────────────────────────────────────────────────────────────────
  // 🟢 HTMX
  // ─────────────────────────────────────────────────────────────────
  "HTMX Form": {
    "prefix": "yelen-htmx-form",
    "body": [
      "<form",
      "  hx-post=\"{% url '${1:app:action}' %}\"",
      "  hx-target=\"#${2:target}\"",
      "  hx-swap=\"${3|innerHTML,outerHTML,beforebegin,afterbegin,beforeend,afterend|}\"",
      "  ${4:hx-indicator=\"#spinner\"}",
      ">",
      "  {% csrf_token %}",
      "  ",
      "  ${5:<!-- Champs du formulaire -->}",
      "  ",
      "  <div class=\"flex gap-3 justify-end mt-6\">",
      "    <button type=\"button\" class=\"btn-secondary\">Annuler</button>",
      "    <button type=\"submit\" class=\"btn-primary\">Enregistrer</button>",
      "  </div>",
      "</form>",
      "$0"
    ],
    "description": "Formulaire HTMX"
  },

  "HTMX Delete Button": {
    "prefix": "yelen-htmx-delete",
    "body": [
      "<button",
      "  hx-delete=\"{% url '${1:app:delete}' ${2:objet}.pk %}\"",
      "  hx-confirm=\"Êtes-vous sûr de vouloir supprimer cet élément ?\"",
      "  hx-target=\"closest ${3:tr}\"",
      "  hx-swap=\"outerHTML swap:1s\"",
      "  class=\"btn-danger\"",
      ">",
      "  Supprimer",
      "</button>",
      "$0"
    ],
    "description": "Bouton suppression HTMX"
  },

  "HTMX Infinite Scroll": {
    "prefix": "yelen-htmx-scroll",
    "body": [
      "{% if ${1:page_obj}.has_next %}",
      "<div",
      "  hx-get=\"{% url '${2:app:liste}' %}?page={{ ${1:page_obj}.next_page_number }}\"",
      "  hx-trigger=\"revealed\"",
      "  hx-swap=\"afterend\"",
      ">",
      "  <div class=\"text-center py-4\">",
      "    <span class=\"text-text-muted\">Chargement...</span>",
      "  </div>",
      "</div>",
      "{% endif %}",
      "$0"
    ],
    "description": "Infinite scroll HTMX"
  },

  "HTMX Search": {
    "prefix": "yelen-htmx-search",
    "body": [
      "<input",
      "  type=\"search\"",
      "  name=\"q\"",
      "  placeholder=\"${1:Rechercher...}\"",
      "  class=\"input\"",
      "  hx-get=\"{% url '${2:app:recherche}' %}\"",
      "  hx-trigger=\"input changed delay:500ms, search\"",
      "  hx-target=\"#${3:results}\"",
      "  hx-indicator=\".htmx-indicator\"",
      "/>",
      "$0"
    ],
    "description": "Champ de recherche HTMX"
  },

  // ─────────────────────────────────────────────────────────────────
  // 🎯 ALPINE.JS
  // ─────────────────────────────────────────────────────────────────
  "Alpine Component": {
    "prefix": "yelen-alpine",
    "body": [
      "<div x-data=\"{",
      "  ${1:open}: false,",
      "  ${2:items}: [],",
      "  ${3:selected}: null",
      "}\">",
      "  ${4:<!-- Contenu Alpine -->}",
      "</div>",
      "$0"
    ],
    "description": "Composant Alpine.js"
  },

  "Alpine Modal": {
    "prefix": "yelen-alpine-modal",
    "body": [
      "<!-- Trigger -->",
      "<button @click=\"${1:showModal} = true\" class=\"btn-primary\">",
      "  ${2:Ouvrir Modal}",
      "</button>",
      "",
      "<!-- Modal -->",
      "<div",
      "  x-show=\"${1:showModal}\"",
      "  x-cloak",
      "  @keydown.escape.window=\"${1:showModal} = false\"",
      "  class=\"fixed inset-0 z-50 flex items-center justify-center\"",
      ">",
      "  <!-- Overlay -->",
      "  <div",
      "    x-show=\"${1:showModal}\"",
      "    x-transition:enter=\"transition ease-out duration-200\"",
      "    x-transition:enter-start=\"opacity-0\"",
      "    x-transition:enter-end=\"opacity-100\"",
      "    x-transition:leave=\"transition ease-in duration-150\"",
      "    x-transition:leave-start=\"opacity-100\"",
      "    x-transition:leave-end=\"opacity-0\"",
      "    @click=\"${1:showModal} = false\"",
      "    class=\"absolute inset-0 bg-black bg-opacity-50\"",
      "  ></div>",
      "",
      "  <!-- Modal Content -->",
      "  <div",
      "    x-show=\"${1:showModal}\"",
      "    x-transition:enter=\"transition ease-out duration-200\"",
      "    x-transition:enter-start=\"opacity-0 scale-95\"",
      "    x-transition:enter-end=\"opacity-100 scale-100\"",
      "    x-transition:leave=\"transition ease-in duration-150\"",
      "    x-transition:leave-start=\"opacity-100 scale-100\"",
      "    x-transition:leave-end=\"opacity-0 scale-95\"",
      "    class=\"relative bg-bg-card rounded-xl p-6 max-w-md w-full mx-4 shadow-xl\"",
      "  >",
      "    <h2 class=\"text-xl font-semibold mb-4\">${3:Titre Modal}</h2>",
      "    <div class=\"mb-6\">",
      "      ${4:<!-- Contenu -->}",
      "    </div>",
      "    <div class=\"flex gap-3 justify-end\">",
      "      <button @click=\"${1:showModal} = false\" class=\"btn-secondary\">Annuler</button>",
      "      <button class=\"btn-primary\">Confirmer</button>",
      "    </div>",
      "  </div>",
      "</div>",
      "$0"
    ],
    "description": "Modal Alpine.js"
  },

  "Alpine Dropdown": {
    "prefix": "yelen-alpine-dropdown",
    "body": [
      "<div x-data=\"{ open: false }\" @click.away=\"open = false\" class=\"relative\">",
      "  <!-- Trigger -->",
      "  <button @click=\"open = !open\" class=\"${1:btn-secondary}\">",
      "    ${2:Actions}",
      "    <svg class=\"w-4 h-4 ml-2\" fill=\"currentColor\" viewBox=\"0 0 20 20\">",
      "      <path d=\"M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z\"/>",
      "    </svg>",
      "  </button>",
      "",
      "  <!-- Dropdown -->",
      "  <div",
      "    x-show=\"open\"",
      "    x-cloak",
      "    x-transition:enter=\"transition ease-out duration-100\"",
      "    x-transition:enter-start=\"transform opacity-0 scale-95\"",
      "    x-transition:enter-end=\"transform opacity-100 scale-100\"",
      "    x-transition:leave=\"transition ease-in duration-75\"",
      "    x-transition:leave-start=\"transform opacity-100 scale-100\"",
      "    x-transition:leave-end=\"transform opacity-0 scale-95\"",
      "    class=\"absolute right-0 mt-2 w-48 bg-bg-card rounded-lg shadow-lg border border-border z-10\"",
      "  >",
      "    <a href=\"#\" class=\"block px-4 py-2 text-sm hover:bg-bg-app\">Option 1</a>",
      "    <a href=\"#\" class=\"block px-4 py-2 text-sm hover:bg-bg-app\">Option 2</a>",
      "  </div>",
      "</div>",
      "$0"
    ],
    "description": "Dropdown Alpine.js"
  },

  // ─────────────────────────────────────────────────────────────────
  // 📋 FORMULAIRES MULTI-ÉTAPES
  // ─────────────────────────────────────────────────────────────────
  "Multi-Step Form": {
    "prefix": "yelen-multistep",
    "body": [
      "<div x-data=\"{",
      "  step: 1,",
      "  totalSteps: ${1:4},",
      "  nextStep() { if (this.step < this.totalSteps) this.step++ },",
      "  prevStep() { if (this.step > 1) this.step-- }",
      "}\">",
      "  <!-- Progress Bar -->",
      "  <div class=\"mb-8\">",
      "    <div class=\"flex justify-between mb-2\">",
      "      <template x-for=\"i in totalSteps\" :key=\"i\">",
      "        <div",
      "          :class=\"i <= step ? 'bg-primary' : 'bg-bg-app'\"",
      "          class=\"h-2 flex-1 mx-1 rounded\"",
      "        ></div>",
      "      </template>",
      "    </div>",
      "    <p class=\"text-sm text-text-muted\">Étape <span x-text=\"step\"></span> sur <span x-text=\"totalSteps\"></span></p>",
      "  </div>",
      "",
      "  <!-- Step 1 -->",
      "  <div x-show=\"step === 1\" x-cloak>",
      "    <h2 class=\"text-xl font-semibold mb-4\">${2:Étape 1}</h2>",
      "    ${3:<!-- Contenu étape 1 -->}",
      "  </div>",
      "",
      "  <!-- Step 2 -->",
      "  <div x-show=\"step === 2\" x-cloak>",
      "    <h2 class=\"text-xl font-semibold mb-4\">${4:Étape 2}</h2>",
      "    ${5:<!-- Contenu étape 2 -->}",
      "  </div>",
      "",
      "  <!-- Navigation -->",
      "  <div class=\"flex gap-3 justify-between mt-6\">",
      "    <button @click=\"prevStep()\" x-show=\"step > 1\" class=\"btn-secondary\">",
      "      Précédent",
      "    </button>",
      "    <button @click=\"nextStep()\" x-show=\"step < totalSteps\" class=\"btn-primary ml-auto\">",
      "      Suivant",
      "    </button>",
      "    <button type=\"submit\" x-show=\"step === totalSteps\" class=\"btn-primary ml-auto\">",
      "      Terminer",
      "    </button>",
      "  </div>",
      "</div>",
      "$0"
    ],
    "description": "Formulaire multi-étapes"
  },

  // ─────────────────────────────────────────────────────────────────
  // 💾 CALCUL ÂGE DYNAMIQUE (Yelen School spécifique)
  // ─────────────────────────────────────────────────────────────────
  "Age Calculator": {
    "prefix": "yelen-age",
    "body": [
      "<div x-data=\"{",
      "  dateNaissance: '',",
      "  calculerAge() {",
      "    if (!this.dateNaissance) return '';",
      "    const today = new Date();",
      "    const birthDate = new Date(this.dateNaissance);",
      "    let age = today.getFullYear() - birthDate.getFullYear();",
      "    const m = today.getMonth() - birthDate.getMonth();",
      "    if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {",
      "      age--;",
      "    }",
      "    return age + ' an' + (age > 1 ? 's' : '');",
      "  }",
      "}\">",
      "  <div class=\"form-group\">",
      "    <label for=\"id_date_naissance\" class=\"input-label\">Date de naissance</label>",
      "    <input",
      "      type=\"date\"",
      "      name=\"date_naissance\"",
      "      id=\"id_date_naissance\"",
      "      class=\"input\"",
      "      x-model=\"dateNaissance\"",
      "    />",
      "  </div>",
      "",
      "  <div class=\"form-group\">",
      "    <label class=\"input-label\">Âge</label>",
      "    <input",
      "      type=\"text\"",
      "      class=\"input-age-readonly\"",
      "      :value=\"calculerAge()\"",
      "      readonly",
      "      disabled",
      "    />",
      "  </div>",
      "</div>",
      "$0"
    ],
    "description": "Calcul âge automatique (Yelen School)"
  },

  // ─────────────────────────────────────────────────────────────────
  // 📊 MESSAGES & NOTIFICATIONS
  // ─────────────────────────────────────────────────────────────────
  "Django Messages": {
    "prefix": "yelen-messages",
    "body": [
      "{% if messages %}",
      "<div class=\"fixed top-4 right-4 z-50 space-y-2\">",
      "  {% for message in messages %}",
      "  <div",
      "    x-data=\"{ show: true }\"",
      "    x-show=\"show\"",
      "    x-init=\"setTimeout(() => show = false, 5000)\"",
      "    class=\"alert alert-{{ message.tags }} shadow-lg\"",
      "  >",
      "    <span>{{ message }}</span>",
      "    <button @click=\"show = false\" class=\"ml-4 text-text-secondary hover:text-text-primary\">",
      "      ✕",
      "    </button>",
      "  </div>",
      "  {% endfor %}",
      "</div>",
      "{% endif %}",
      "$0"
    ],
    "description": "Messages Django"
  }
}
