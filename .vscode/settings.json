{
  // ═══════════════════════════════════════════════════════════════════
  // YELEN SCHOOL - Configuration VSCode Globale
  // Projet : Gestion Scolaire pour le Burkina Faso
  // Stack : Django 4.2 + HTMX + Alpine.js + Tailwind CSS
  // ═══════════════════════════════════════════════════════════════════

  // ─────────────────────────────────────────────────────────────────
  // 🎨 APPARENCE & INTERFACE
  // ─────────────────────────────────────────────────────────────────
  "workbench.colorTheme": "One Dark Pro Darker",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.tree.indent": 20,
  "window.zoomLevel": 0,
  "editor.fontSize": 14,
  "editor.lineHeight": 22,
  "editor.fontFamily": "'Fira Code', 'Cascadia Code', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,

  // ─────────────────────────────────────────────────────────────────
  // 📝 ÉDITION & FORMATAGE
  // ─────────────────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.wordWrap": "on",
  "editor.rulers": [79, 120],
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 120,
  "editor.renderWhitespace": "selection",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.stickyScroll.enabled": true,
  "editor.linkedEditing": true,
  "editor.suggestSelection": "first",
  "editor.quickSuggestions": {
    "strings": true
  },

  // ─────────────────────────────────────────────────────────────────
  // 🐍 PYTHON & DJANGO
  // ─────────────────────────────────────────────────────────────────
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe",
  "python.envFile": "${workspaceFolder}/.env",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  
  // Linting & Formatage Python (extensions Ruff/Black)
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  "black-formatter.args": ["--line-length=120", "--skip-string-normalization"],
  "flake8.args": ["--max-line-length=120", "--extend-ignore=E203,W503"],
  "flake8.ignorePatterns": ["**/migrations/**", "**/__pycache__/**"],
  
  // Django spécifique
  "python.analysis.extraPaths": [
    "${workspaceFolder}"
  ],
  "python.analysis.ignore": ["**"],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingImports": "none",
    "reportMissingTypeStubs": "none",
    "reportMissingModuleSource": "none",
    "reportAttributeAccessIssue": "none",
    "reportOperatorIssue": "none",
    "reportIndexIssue": "none",
    "reportCallIssue": "none",
    "reportReturnType": "none",
    "reportArgumentType": "none",
    "reportAssignmentType": "none",
    "reportGeneralTypeIssues": "none",
    "reportOptionalCall": "none",
    "reportOptionalMemberAccess": "none",
    "reportOptionalSubscript": "none",
    "reportPrivateImportUsage": "none"
  },
  
  // Auto-imports
  "python.analysis.autoImportCompletions": true,
  "python.analysis.completeFunctionParens": true,

  // ─────────────────────────────────────────────────────────────────
  // 🧪 TESTING (pytest obligatoire, coverage > 80%)
  // ─────────────────────────────────────────────────────────────────
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": [
    ".",
    "--verbose",
    "--color=yes",
    "--cov=apps",
    "--cov-report=html",
    "--cov-report=term-missing",
    "--cov-fail-under=80"
  ],
  "python.testing.autoTestDiscoverOnSaveEnabled": true,

  // ─────────────────────────────────────────────────────────────────
  // 🎯 DJANGO TEMPLATES (HTMX + Alpine.js)
  // ─────────────────────────────────────────────────────────────────
  "files.associations": {
    "*.html": "html",
    "**/templates/**/*.html": "django-html",
    "**/templates/**": "django-html",
    "*.css": "tailwindcss"
  },
  
  "emmet.includeLanguages": {
    "django-html": "html",
    "html": "html"
  },
  
  "emmet.triggerExpansionOnTab": true,
  "emmet.showExpandedAbbreviation": "always",
  
  // Django Template Snippets
  "[django-html]": {
    "editor.defaultFormatter": "batisteo.vscode-django",
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    }
  },

  // ─────────────────────────────────────────────────────────────────
  // 🎨 TAILWIND CSS (Design System Yelen)
  // ─────────────────────────────────────────────────────────────────
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "django-html": "html",
    "javascript": "javascript",
    "typescript": "typescript"
  },
  
  "tailwindCSS.experimental.classRegex": [
    ["class:\\s*?[\"'`]([^\"'`]*).*?[\"'`]", "[\"'`]([^\"'`]*).*?[\"'`]"],
    ["className\\s*?:\\s*?[\"'`]([^\"'`]*).*?[\"'`]", "[\"'`]([^\"'`]*).*?[\"'`]"]
  ],
  
  "css.validate": true,
  "css.lint.unknownAtRules": "ignore",

  // ─────────────────────────────────────────────────────────────────
  // 🟢 HTMX & Alpine.js
  // ─────────────────────────────────────────────────────────────────
  "html.customData": [
    ".vscode/htmx.html-data.json",
    ".vscode/alpine.html-data.json"
  ],
  
  "html.autoClosingTags": true,
  "html.format.indentInnerHtml": true,
  "html.format.wrapLineLength": 120,

  // ─────────────────────────────────────────────────────────────────
  // 📦 JAVASCRIPT (Alpine.js uniquement)
  // ─────────────────────────────────────────────────────────────────
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
    "editor.formatOnSave": true
  },
  
  "javascript.updateImportsOnFileMove.enabled": "always",
  "javascript.suggest.autoImports": true,

  // ─────────────────────────────────────────────────────────────────
  // 📄 JSON, YAML, TOML
  // ─────────────────────────────────────────────────────────────────
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.tabSize": 2
  },
  
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.tabSize": 2
  },

  // ─────────────────────────────────────────────────────────────────
  // 🐳 DOCKER & DOCKER-COMPOSE
  // ─────────────────────────────────────────────────────────────────
  "docker.dockerPath": "docker",
  "docker.dockerComposePath": "docker-compose",
  
  "[dockerfile]": {
    "editor.defaultFormatter": "ms-azuretools.vscode-docker",
    "editor.tabSize": 2
  },

  // ─────────────────────────────────────────────────────────────────
  // 🗄️ SQL (PostgreSQL 15)
  // ─────────────────────────────────────────────────────────────────
  "[sql]": {
    "editor.defaultFormatter": "mtxr.sqltools",
    "editor.tabSize": 2,
    "editor.formatOnSave": true
  },

  // ─────────────────────────────────────────────────────────────────
  // 📁 FICHIERS & EXCLUSIONS
  // ─────────────────────────────────────────────────────────────────
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/*.pyo": true,
    "**/node_modules": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.coverage": true,
    "**/htmlcov": true,
    "**/*.egg-info": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.venv/**": true,
    "**/venv/**": true,
    "**/staticfiles/**": true,
    "**/media/**": true
  },
  
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/venv": true,
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/staticfiles": true,
    "**/media": true,
    "**/migrations": false,
    "**/.git": true
  },
  
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.encoding": "utf8",
  "files.eol": "\n",

  // ─────────────────────────────────────────────────────────────────
  // 🔍 RECHERCHE & SYMBOLES
  // ─────────────────────────────────────────────────────────────────
  "search.smartCase": true,
  "search.useIgnoreFiles": true,
  "search.showLineNumbers": true,

  // ─────────────────────────────────────────────────────────────────
  // 🔧 GIT & VERSION CONTROL
  // ─────────────────────────────────────────────────────────────────
  "git.enabled": true,
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.suggestSmartCommit": true,
  "git.ignoreMissingGitWarning": false,
  
  "gitlens.advanced.messages": {
    "suppressCommitHasNoPreviousCommitWarning": false,
    "suppressCommitNotFoundWarning": false,
    "suppressFileNotUnderSourceControlWarning": false,
    "suppressGitVersionWarning": false,
    "suppressLineUncommittedWarning": false,
    "suppressNoRepositoryWarning": false
  },

  // ─────────────────────────────────────────────────────────────────
  // 💾 SAUVEGARDE AUTOMATIQUE
  // ─────────────────────────────────────────────────────────────────
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 2000,

  // ─────────────────────────────────────────────────────────────────
  // 🎯 PRETTIER (pour JS, JSON, YAML uniquement)
  // ─────────────────────────────────────────────────────────────────
  "prettier.semi": true,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "es5",
  "prettier.tabWidth": 2,
  "prettier.printWidth": 100,

  // ─────────────────────────────────────────────────────────────────
  // 🚀 TERMINAL
  // ─────────────────────────────────────────────────────────────────
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.fontFamily": "'Fira Code', monospace",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.env.linux": {
    "PYTHONPATH": "${workspaceFolder}"
  },

  // ─────────────────────────────────────────────────────────────────
  // 📋 SNIPPETS PERSONNALISÉS YELEN SCHOOL
  // ─────────────────────────────────────────────────────────────────
  "editor.snippetSuggestions": "top",

  // ─────────────────────────────────────────────────────────────────
  // 🔐 SÉCURITÉ & EXTENSIONS
  // ─────────────────────────────────────────────────────────────────
  "security.workspace.trust.untrustedFiles": "open",
  "extensions.ignoreRecommendations": false,

  // ─────────────────────────────────────────────────────────────────
  // 📊 PERFORMANCES
  // ─────────────────────────────────────────────────────────────────
  "files.maxMemoryForLargeFilesMB": 4096,
  "editor.maxTokenizationLineLength": 20000,

  // ─────────────────────────────────────────────────────────────────
  // 🌍 SPÉCIFICITÉS BURKINA FASO
  // ─────────────────────────────────────────────────────────────────
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.suggestOnTriggerCharacters": true,
  "editor.parameterHints.enabled": true,
  
  // Commentaires obligatoirement en français
  "cSpell.language": "fr,en",
  "cSpell.userWords": [
    "Yelen",
    "MENA",
    "Burkina",
    "Faso",
    "HTMX",
    "Alpine",
    "Weasy",
    "WeasyPrint",
    "MinIO",
    "PostgreSQL",
    "Celery",
    "pytest",
    "djangorestframework",
    "tailwindcss",
    "annee",
    "Annee",
    "annees",
    "eleve",
    "eleves",
    "etablissement",
    "prenom",
    "nom",
    "scolarite",
    "Scolarite",
    "echeance",
    "echeances",
    "echeancier",
    "Echeancier",
    "financiere",
    "redevable",
    "redevables",
    "paiement",
    "paiements",
    "rubrique",
    "rubriques",
    "classe",
    "classes",
    "cycle",
    "cycles",
    "tarif",
    "tarifs",
    "inscription",
    "inscriptions",
    "statut",
    "signataire",
    "signataires",
    "periode",
    "periodes",
    "bulletin",
    "bulletins",
    "pedagogie",
    "pedagogique",
    "vacations",
    "presences",
    "viescolaire",
    "parametres",
    "parametres",
    "matieres",
    "matiere",
    "discipline",
    "disciplines",
    "examen",
    "examens",
    "resultat",
    "resultats",
    "moyenne",
    "moyennes",
    "coefficient",
    "coefficients",
    "appréciation",
    "appreciation",
    "appreciations",
    "personnel",
    "matricule",
    "FCFA",
    "ESPECES",
    "etre",
    "ete",
    "redoublee",
    "exonere",
    "exoneres",
    "boursier",
    "affecte",
    "curseur",
    "interdit",
    "etab",
    "inscr",
    "identite",
    "recu",
    "Recu",
    "regulier",
    "redevabilite",
    "Redevabilite",
    "derniere",
    "linecap",
    "linejoin",
    "rgba",
    "Playfair",
    "stylesheet",
    "htmx",
    "csrf",
    "topbar",
    "Topbar",
    "nowrap",
    "releve",
    "activite",
    "activites",
    "categorie",
    "categories",
    "django",
    "endfor",
    "parametre",
    "endblock",
    "endif",
    "endwith",
    "forloop",
    "hx-get",
    "hx-post",
    "hx-target",
    "hx-trigger",
    "hx-include",
    "hx-swap",
    "hx-push-url",
    "hx-select",
    "hx-vals",
    "accordion",
    "submenu",
    "chevron",
    "sidebar",
