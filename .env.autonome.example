# ============================================================================
#  YELEN SCHOOL — Configuration MODE AUTONOME (serveur d'école, sans Docker)
# ============================================================================
#  Copier ce fichier en `.env` à la racine du projet, puis lancer :
#     Windows : demarrer-autonome.bat
#     Linux   : ./demarrer-autonome.sh
#
#  Architecture : l'application tourne sur UNE machine (le serveur) ; les
#  postes de l'école y accèdent par navigateur  →  http://IP-DU-SERVEUR:8000
#  Aucun service externe : la base est un fichier SQLite (dossier data/).
# ----------------------------------------------------------------------------

# --- Base de données : SQLite embarqué --------------------------------------
DB_ENGINE=sqlite
# Emplacement du fichier (disque LOCAL du serveur — jamais un partage réseau)
# SQLITE_PATH=C:\YELEN\data\yelen_school.sqlite3
# Par défaut : <projet>/data/yelen_school.sqlite3

# --- Cache partagé entre workers (aucun Redis nécessaire) -------------------
CACHE_BACKEND=database

# --- Sécurité ---------------------------------------------------------------
# Générer avec :  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGEZ-MOI-generer-une-cle-unique
DEBUG=False
# Réseau local sans certificat HTTPS → pas de redirection HTTPS
DISABLE_HTTPS_REDIRECT=true
# Hôtes autorisés : IP fixe du serveur + nom de machine (l'IP locale est
# ajoutée automatiquement, mais mieux vaut l'indiquer explicitement)
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10,serveur-ecole
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://192.168.1.10:8000,http://serveur-ecole:8000

# --- Serveur web ------------------------------------------------------------
# Port d'écoute (ouvrir ce port dans le pare-feu du serveur)
PORT=8000
# Threads Waitress (Windows) / workers Gunicorn (Linux). 8 convient à 20-40 postes.
WEB_THREADS=8
WEB_WORKERS=4

# --- Compte administrateur initial -----------------------------------------
# true au premier démarrage, puis false (sinon le mot de passe est réinitialisé)
ENSURE_ADMIN=true

# --- Sauvegarde automatique -------------------------------------------------
# Dossier de destination (idéalement un 2e disque ou une clé USB dédiée)
BACKUP_DIR=./data/backups
# Nombre de sauvegardes quotidiennes conservées
BACKUP_KEEP=30

# --- Email (facultatif : vide = affichage console) --------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- SMS (facultatif) -------------------------------------------------------
SMS_ENABLED=False
SMS_BACKEND=http
SMS_HTTP_URL=http://192.168.1.x:8080/message
SMS_HTTP_USER=admin
SMS_HTTP_PASSWORD=
SMS_HTTP_TIMEOUT=10
