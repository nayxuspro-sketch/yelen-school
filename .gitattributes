# Fins de ligne normalisées : LF dans le dépôt et dans les copies de travail
# (les scripts exécutés dans les conteneurs Linux — entrypoint.sh, *.sh — cassent
# avec des CRLF introduits par core.autocrlf=true sous Windows).
*               text=auto eol=lf
*.sh            text eol=lf
entrypoint.sh   text eol=lf
Dockerfile      text eol=lf

# Scripts Windows : CRLF attendus par cmd.exe / PowerShell
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binaires
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text eol=lf
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.sqlite3 binary
