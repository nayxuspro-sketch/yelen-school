SECRET_KEY=generer-une-cle-avec-python-c secrets-token-urlsafe-64
DEBUG=False
# Mettre true pour un déploiement local sans HTTPS (port 8000 direct)
# Mettre false (ou omettre) pour la production derrière nginx avec SSL
DISABLE_HTTPS_REDIRECT=true
# Port HTTP local (8000 par défaut). L'installateur essaie automatiquement
# 8000, 8001, 8002, 8003, 8004 puis 8005 si le port demandé est occupé.
# YELEN_HTTP_PORT=8000
ALLOWED_HOSTS=.votre-domaine.com,www.votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

DB_NAME=yelen_school_db
DB_USER=yelen_user
# ⚠️ Pour un NOUVEAU déploiement (volume DB vierge) : utiliser un mot de passe fort
#    Pour un volume DB EXISTANT : utiliser le mot de passe de création (ex: yelen_password_dev)
DB_PASSWORD=generer-un-mot-de-passe-fort
DB_HOST=db
DB_PORT=5432

# Créer/réinitialiser l'admin au démarrage (true|false)
# Mettre false après le premier déploiement pour éviter la réinitialisation
ENSURE_ADMIN=true
REDIS_URL=redis://redis:6379/0

# Stockage S3/MinIO (optionnel — sinon stockage local)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=votre-access-key
MINIO_SECRET_KEY=votre-secret-key
MINIO_BUCKET=yelen-documents

# Email — laisser EMAIL_HOST vide pour utiliser le backend console (sans envoi)
EMAIL_HOST=smtp.votre-domaine.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-email
EMAIL_HOST_PASSWORD=votre-mot-de-passe
EMAIL_USE_TLS=True

# SMS (optionnel)
SMS_ENABLED=False
SMS_BACKEND=http
SMS_HTTP_URL=http://192.168.1.x:8080/message
SMS_HTTP_USER=admin
SMS_HTTP_PASSWORD=votre-mot-de-passe
SMS_HTTP_TIMEOUT=10
SMS_WEBHOOK_TOKEN=generer-un-token-avec-secrets-token-urlsafe-32
SMS_ALLOWED_IPS=192.168.1.100,192.168.1.101

