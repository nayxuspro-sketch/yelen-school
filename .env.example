SECRET_KEY=generer-une-cle-avec-python-c secrets-token-urlsafe-64
DEBUG=False
# Contrôle des licences (anti-fraude) :
#   true  (production) → licence expirée/révoquée = accès bloqué
#   false (démo/dev)   → aucune restriction
LICENSE_ENFORCEMENT=true
# Options avancées du contrôle de licence (défauts entre parenthèses) :
#   LICENCE_ANTITAMPER_ENABLED (false) → contrôle d'intégrité strict au premier appel HTTP ;
#     en cas d'anomalie l'application répond 503 au lieu de servir les pages
#   LICENCE_DISABLE_STRICT_BOOT (false) → true pour contourner ce contrôle (dépannage uniquement)
#   LICENCE_BINDING_ENABLED (false)     → liaison de la licence au matériel du serveur
#   LICENCE_PUBLIC_KEY ('')             → clé publique de vérification des licences signées
#   LICENCE_HEARTBEAT_URL ('')          → URL de contrôle en ligne ; LICENCE_HEARTBEAT_INTERVAL_HOURS (24),
#     LICENCE_OFFLINE_GRACE_DAYS (7), LICENCE_OFFLINE_MAX_DAYS (30)
# LICENCE_ANTITAMPER_ENABLED=false
# LICENCE_DISABLE_STRICT_BOOT=false
# LICENCE_BINDING_ENABLED=false
# Mettre true pour un déploiement local sans HTTPS (port 8000 direct)
# Mettre false (ou omettre) pour la production derrière nginx avec SSL
DISABLE_HTTPS_REDIRECT=true
# Port HTTP local (8000 par défaut). L'installateur essaie automatiquement
# 8000, 8001, 8002, 8003, 8004 puis 8005 si le port demandé est occupé.
# YELEN_HTTP_PORT=8000
ALLOWED_HOSTS=.votre-domaine.com,www.votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

DB_NAME=yelen_school_db
DB_USER=yelen_user
# ⚠️ Pour un NOUVEAU déploiement (volume DB vierge) : utiliser un mot de passe fort
#    Pour un volume DB EXISTANT : utiliser le mot de passe de création (ex: yelen_password_dev)
DB_PASSWORD=generer-un-mot-de-passe-fort
DB_HOST=db
DB_PORT=5432
# Moteur : postgresql (serveur Docker, défaut) | sqlite (mode autonome, voir .env.autonome.example)
# DB_ENGINE=postgresql
# Chemin du fichier SQLite (mode autonome uniquement)
# SQLITE_PATH=data/yelen_school.sqlite3

# Créer l'admin initial au démarrage (true|false)
# L'installateur génère ce secret puis le supprime du .env après démarrage.
ENSURE_ADMIN=true
# Mot de passe initial de admin@yelen.edu : 12 caractères minimum (politique de l'application) ;
# changement obligatoire à la première connexion. Réinitialisation : manage.py ensure_admin --reset
INITIAL_ADMIN_PASSWORD=generer-un-secret-admin-d-au-moins-12-caracteres
REDIS_URL=redis://redis:6379/0
# Cache : redis (défaut en PostgreSQL) | database (défaut en SQLite) | file (CACHE_DIR) | locmem (mono-process)
# CACHE_BACKEND=redis
# CACHE_DIR=data/cache

# Sessions et jetons
# Durée de session inactive, en secondes (3600 = 1 heure)
# SESSION_COOKIE_AGE=3600
# Durée de validité des jetons API, en heures
# TOKEN_EXPIRY_HOURS=24

# Stockage S3/MinIO (optionnel — sinon stockage local)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=votre-access-key
MINIO_SECRET_KEY=votre-secret-key
MINIO_BUCKET=yelen-documents

# Email — laisser EMAIL_HOST vide pour utiliser le backend console (sans envoi)
EMAIL_HOST=smtp.votre-domaine.com
EMAIL_PORT=587
EMAIL_HOST_USER=votre-email
EMAIL_HOST_PASSWORD=votre-mot-de-passe
EMAIL_USE_TLS=True

# SMS (optionnel)
SMS_ENABLED=False
SMS_BACKEND=http
SMS_HTTP_URL=http://192.168.1.x:8080/message
SMS_HTTP_USER=admin
SMS_HTTP_PASSWORD=votre-mot-de-passe
SMS_HTTP_TIMEOUT=10
# Le script d'installation remplace cette valeur par un secret aléatoire.
SMS_WEBHOOK_TOKEN=generer-un-token-avec-secrets-token-urlsafe-32
# Optionnel : secret HMAC-SHA256 partagé avec la passerelle SMS.
# SMS_WEBHOOK_HMAC_SECRET=generer-un-secret-hmac
SMS_WEBHOOK_RATE_LIMIT=60
# Optionnel : liste d'IP de la passerelle, séparées par des virgules.
SMS_ALLOWED_IPS=

# SMS par modem GSM USB ou Bluetooth (SMS_BACKEND=serial ; défaut http = passerelle Android)
# SMS_MODEM_PORT=COM3
# SMS_MODEM_BAUD=9600
# SMS_MODEM_TIMEOUT=10

# Sauvegarde à chaud SQLite (manage.py sauvegarde_sqlite, mode autonome)
# BACKUP_DIR=./data/backups
# BACKUP_KEEP=30
